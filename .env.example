# Copiar a .env o ejecutar npm run setup (genera valores locales aleatorios).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL="file:./farmacia.db"
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=REEMPLAZAR_POR_AL_MENOS_32_CARACTERES_ALEATORIOS
JWT_EXPIRES_IN=30m
ADMIN_EMAIL=admin@farmacia.example.ec
ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_PRIVADA
# HTTPS opcional: rutas al certificado y clave, nunca incluirlos en el ZIP.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Producción opcional: render.yaml y docs/DESPLIEGUE-GRATUITO.md.
# No sustituir la configuración SQLite local; estos valores se guardan en Render.
# IMAGE_STORAGE=supabase
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_CLAVE_PRIVADA_SOLO_EN_EL_SERVIDOR
# Compatibilidad: si no tienes Secret key, usa solo la clave service_role heredada.
# SUPABASE_SERVICE_ROLE_KEY=CLAVE_PRIVADA_HEREDADA_SOLO_EN_EL_SERVIDOR
# SUPABASE_STORAGE_BUCKET=farmaciaproductos
# SKIP_INITIAL_SEED=true
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/postgres?sslmode=require&connection_limit=2
