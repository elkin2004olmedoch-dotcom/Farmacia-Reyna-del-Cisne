{
  "name": "farmacia-reina-del-cisne-mvc",
  "version": "2.0.0",
  "private": true,
  "description": "Reto 2: farmacia con frontend y backend MVC, Prisma y seguridad",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup-reto2.cjs",
    "start": "node server/index.cjs",
    "dev": "node --watch server/index.cjs",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.cjs",
    "db:studio": "prisma studio --schema server/prisma/schema.prisma",
    "test": "node --test --test-concurrency=1 tests/reto2/*.test.cjs",
    "test:reto1": "node --test tests/*.test.cjs",
    "test:browser": "playwright test --config tests/reto2/playwright.config.cjs",
    "build:frontend": "node scripts/build-frontend.cjs",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/crear-reto2.ps1",
    "cert:dev": "node scripts/create-dev-cert.cjs",
    "start:https": "node scripts/https-dev.cjs",
    "verify": "node scripts/verify-reto2.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-validator": "7.3.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
