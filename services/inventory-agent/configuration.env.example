# Reference only: ASP.NET reads real environment variables, not this file.
# Keep filled copies outside Git. Configure TLS and private host before enabling.
InventoryAgent__Enabled=false
InventoryAgent__SourceMode=Integrated
InventoryAgent__Schema=inventory_agent
InventoryAgent__ConnectionString=
InventoryAgent__AdminApiKey=
InventoryAgent__DailyHour=8
InventoryAgent__ExpiryAlertDays=30
InventoryAgent__ApprovalHours=24
InventoryAgent__OutboxPollSeconds=30
InventoryAgent__Email__Enabled=false
InventoryAgent__Email__Host=smtp.gmail.com
InventoryAgent__Email__Port=587
InventoryAgent__Email__ImplicitTls=false
InventoryAgent__Email__From=
InventoryAgent__Email__Username=
InventoryAgent__Email__Password=
InventoryAgent__Email__OAuthAccessToken=
InventoryAgent__Telegram__Enabled=false
InventoryAgent__Telegram__BotToken=
InventoryAgent__Telegram__WebhookSecret=
InventoryAgent__Telegram__ManagerUserId=
InventoryAgent__Telegram__ManagerChatId=
InventoryAgent__WhatsApp__Enabled=false
InventoryAgent__WhatsApp__EligibilityConfirmed=false
InventoryAgent__WhatsApp__AccessToken=
InventoryAgent__WhatsApp__AppSecret=
InventoryAgent__WhatsApp__VerifyToken=
InventoryAgent__WhatsApp__PhoneNumberId=
InventoryAgent__WhatsApp__WabaId=
InventoryAgent__WhatsApp__ManagerNumber=
InventoryAgent__WhatsApp__GraphVersion=v26.0
InventoryAgent__WhatsApp__TemplateName=
InventoryAgent__WhatsApp__NoticeTemplateName=
InventoryAgent__WhatsApp__TemplateLanguage=es
# Templates: approval = one body text parameter + quick reply buttons 0/1;
# notice = one body text parameter, no approval buttons. Both must be approved.
AllowedHosts=localhost;127.0.0.1
