generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Producto {
  id          String   @id @default(uuid())
  nombre      String
  precio      Decimal
  stock       Int      @default(0)
  categoria   String
  descripcion String
  advertencias String?
  imagen      String
  alt         String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  descuentoPorcentaje Int @default(0)
  ivaCategoria String @default("general")
  fundamentoIva String?
  tipoProducto String @default("cuidado")
  codigoInterno String? @unique
  codigoBarras String?
  laboratorio String?
  principioActivo String?
  concentracion String?
  presentacion String?
  registroSanitario String?
  requiereReceta Boolean @default(false)
  controlado Boolean @default(false)
  biologico Boolean @default(false)
  cadenaFrio Boolean @default(false)
  stockMinimo Int @default(5)
  pvpMaximo Decimal?
  lotes Lote[]
  movimientos MovimientoInventario[]
  detalles    PedidoDetalle[]
  promociones Promocion[]
  favoritos Favorito[]
  resenas ResenaProducto[]
  @@index([activo, categoria])
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  telefono     String
  passwordHash String
  role         String   @default("user")
  tokenVersion Int      @default(0)
  tokenEpoch String?
  activo       Boolean  @default(true)
  emailVerifiedAt DateTime?
  emailVerificationRequired Boolean @default(false)
  createdAt    DateTime @default(now())
  emailVerification EmailVerification?
  registroPendiente RegistroPendiente?
  pedidos      Pedido[]
  cambiosPedidos PedidoEstado[]
  entregas Entrega[]
  sesionesMoviles SesionMovil[]
  sesionesWeb SesionWeb[]
  passwordReset PasswordReset?
  adminMfa AdminMfa?
  direcciones DireccionGuardada[]
  favoritos Favorito[]
  resenas ResenaProducto[]
  incidenciasEntrega EntregaIncidencia[]
  cambiosTarifa ZonaEntregaTarifa[]
  configuracionesFiscales ConfiguracionFiscal[]
  movimientos MovimientoInventario[]
}

model EmailVerification {
  usuarioId String @id
  usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  email String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Pedido {
  id             String   @id @default(uuid())
  userId         String
  usuario        Usuario  @relation(fields: [userId], references: [id], onDelete: Restrict)
  total          Decimal
  subtotalProductos Decimal?
  costoEnvioCentavos Int @default(0)
  envioIvaPorcentaje Int?
  envioBaseImponible Decimal?
  envioIvaMonto Decimal?
  zonaEntregaId String?
  zonaEntrega ZonaEntrega? @relation(fields:[zonaEntregaId],references:[id],onDelete:Restrict)
  latitudEntrega Float?
  longitudEntrega Float?
  ubicacionEntregaAceptadaAt DateTime?
  reparto Entrega?
  baseImponible  Decimal?
  ivaMonto       Decimal?
  estado         String   @default("pendiente")
  entrega        String
  nombre         String
  email          String
  telefono       String
  documento      String
  provincia      String?
  ciudad         String?
  direccion      String?
  codigoPostal   String?
  requestKey     String
  fingerprint    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  detalles       PedidoDetalle[]
  historial      PedidoEstado[]
  movimientos    MovimientoInventario[]
  factura        FacturaPedido?
  pago           Pago?
  pagoPractica   PagoPractica?
  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([zonaEntregaId])
}

model PedidoDetalle {
  id             String   @id @default(uuid())
  pedidoId       String
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  nombreProducto String
  cantidad       Int
  precioUnitario Decimal
  precioOriginal Decimal?
  descuentoPorcentaje Int @default(0)
  ivaPorcentaje Int?
  baseImponible Decimal?
  ivaMonto Decimal?
  totalLinea Decimal?
  resena ResenaProducto?
  lotes PedidoDetalleLote[]
  @@unique([pedidoId, productoId])
}

model Promocion {
  id          String   @id @default(uuid())
  titulo      String
  descripcion String
  etiqueta    String
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  activa      Boolean  @default(true)
  vistaPrevia Boolean  @default(false)
  descuentoPorcentaje Int @default(0)
  imagen      String?
  alt         String?
  orden       Int      @default(0)
  inicio      DateTime?
  fin         DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model PedidoEstado {
  id        String   @id @default(uuid())
  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  anterior  String?
  estado    String
  actorId   String
  actor     Usuario  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([pedidoId, createdAt])
}

// Technical marker: the initial catalog is seeded once, including legacy DBs.
model Semilla {
  id        String   @id
  createdAt DateTime @default(now())
}

model ConfiguracionFiscal {
  id String @id @default(uuid())
  tarifaGeneral Int
  inicioVigencia DateTime @unique
  referenciaNormativa String
  actorId String?
  actor Usuario? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proveedor {
  id String @id @default(uuid())
  nombre String
  ruc String @unique
  email String
  telefono String
  direccion String
  activo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lotes Lote[]
}

model Lote {
  id String @id @default(uuid())
  productoId String
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  numero String
  vencimiento String
  stock Int
  costoUnitario Decimal
  proveedorId String?
  proveedor Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movimientos MovimientoInventario[]
  detalles PedidoDetalleLote[]
  @@unique([productoId, numero])
  @@index([productoId, vencimiento])
}

model MovimientoInventario {
  id String @id @default(uuid())
  productoId String
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  loteId String?
  lote Lote? @relation(fields: [loteId], references: [id], onDelete: Restrict)
  actorId String?
  actor Usuario? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  pedidoId String?
  pedido Pedido? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  tipo String
  cantidad Int
  motivo String
  createdAt DateTime @default(now())
  @@index([productoId, createdAt])
}

model PedidoDetalleLote {
  id String @id @default(uuid())
  detalleId String
  detalle PedidoDetalle @relation(fields: [detalleId], references: [id], onDelete: Cascade)
  loteId String
  lote Lote @relation(fields: [loteId], references: [id], onDelete: Restrict)
  cantidad Int
  @@unique([detalleId, loteId])
}

model ConfiguracionEmisor {
  id String @id @default("principal")
  ruc String
  razonSocial String
  nombreComercial String
  direccionMatriz String
  direccionEstablecimiento String
  establecimiento String @default("001")
  puntoEmision String @default("001")
  ambiente String @default("1")
  obligadoContabilidad Boolean @default(false)
  softwarePropio Boolean @default(true)
  rucProveedorSoftware String?
  certificadoCifrado String?
  certificadoVenceEn DateTime?
  certificadoRuc String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecuenciaFactura {
  id String @id @default(uuid())
  emisorRuc String
  ambiente String
  establecimiento String
  puntoEmision String
  ultimo Int @default(0)
  @@unique([emisorRuc,ambiente,establecimiento,puntoEmision])
}

model FacturaPedido {
  id String @id @default(uuid())
  pedidoId String @unique
  pedido Pedido @relation(fields:[pedidoId],references:[id],onDelete:Restrict)
  estado String @default("BORRADOR")
  ambiente String
  emisorRuc String
  establecimiento String
  puntoEmision String
  secuencial Int?
  claveAcceso String? @unique
  fechaEmision DateTime?
  snapshot String
  xmlBorrador String
  xmlFirmado String?
  xmlAutorizado String?
  numeroAutorizacion String?
  fechaAutorizacion DateTime?
  mensajes String @default("[]")
  ultimoError String?
  procesandoHasta DateTime?
  intentos Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([emisorRuc,ambiente,establecimiento,puntoEmision,secuencial])
  @@index([createdAt])
}
model ZonaEntrega {
  alcance String @default("local")
  id String @id @default(uuid())
  nombre String
  provincia String
  canton String
  tarifaCentavos Int?
  ivaCategoria String @default("general")
  fundamentoIva String?
  activa Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pedidos Pedido[]
  tarifas ZonaEntregaTarifa[]
  @@index([activa, nombre])
}

model ZonaEntregaTarifa {
  alcance String @default("local")
  id String @id @default(uuid())
  zonaEntregaId String
  zona ZonaEntrega @relation(fields:[zonaEntregaId],references:[id],onDelete:Restrict)
  version Int
  tarifaCentavos Int?
  ivaCategoria String
  fundamentoIva String?
  actorId String?
  actor Usuario? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  @@unique([zonaEntregaId,version])
}

model Entrega {
  codigoEntregaRequerido Boolean @default(false)
  codigoEntregaNonce String?
  codigoIntentos Int @default(0)
  codigoBloqueadoHasta DateTime?
  estimadaDesde DateTime?
  estimadaHasta DateTime?
  estimadaCalculadaAt DateTime?
  estimadaFuente String?
  estimadaGpsVersion Int?
  estimadaMuestraAt DateTime?
  estimadaVenceAt DateTime?
  estimadaRepartidorId String?
  incidencias EntregaIncidencia[]
  id String @id @default(uuid())
  pedidoId String @unique
  pedido Pedido @relation(fields:[pedidoId],references:[id],onDelete:Restrict)
  repartidorId String?
  repartidor Usuario? @relation(fields:[repartidorId],references:[id],onDelete:Restrict)
  estado String @default("asignada")
  version Int @default(1)
  gpsVersion Int @default(0)
  sesionSeguimientoId String? @unique
  sesionSeguimiento SesionMovil? @relation(fields:[sesionSeguimientoId],references:[id],onDelete:Restrict)
  asignadaAt DateTime @default(now())
  salidaAt DateTime?
  llegadaAt DateTime?
  finalizadaAt DateTime?
  latitud Float?
  longitud Float?
  precision Float?
  registradaAt DateTime?
  recibidaAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([repartidorId,estado])
  @@index([estado,createdAt])
  @@index([recibidaAt])
}

model SesionMovil {
  id String @id @default(uuid())
  usuarioId String
  usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Restrict)
  tokenVersion Int
  secretHash String
  previousSecretHash String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entrega Entrega?
  @@index([usuarioId,expiresAt])
  @@index([expiresAt])
}

model Pago {
  id String @id @default(uuid())
  pedidoId String @unique
  pedido Pedido @relation(fields:[pedidoId],references:[id],onDelete:Restrict)
  proveedor String @default("payphone")
  entorno String
  estado String @default("creando")
  moneda String @default("USD")
  totalCentavos Int
  sinIvaCentavos Int
  baseIvaCentavos Int
  ivaCentavos Int
  paymentId String? @unique
  providerTransactionId Int? @unique
  urlPago String?
  confirmacionIniciadaAt DateTime?
  confirmadaAt DateTime?
  revisionMotivo String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PagoPractica {
  id String @id @default(uuid())
  pedidoId String @unique
  pedido Pedido @relation(fields:[pedidoId],references:[id],onDelete:Restrict)
  metodo String
  marca String?
  totalCentavos Int
  createdAt DateTime @default(now())
}

model SesionWeb {
 registroPendiente RegistroPendiente?
 id String @id @default(uuid())
 usuarioId String
 usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 tokenVersion Int
 secretHash String
 previousSecretHash String?
 previousUntil DateTime?
 expiresAt DateTime
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@index([usuarioId,createdAt])
 @@index([usuarioId,expiresAt])
}

model PasswordReset {
 usuarioId String @id
 usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 email String
 tokenHash String @unique
 expiresAt DateTime
 createdAt DateTime @default(now())
}

model AdminMfa {
 usuarioId String @id
 usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 secretCipher String
 enabled Boolean @default(false)
 setupExpiresAt DateTime?
 lastCounter Int @default(-1)
 recoveryHashes String @default("[]")
 challengeHash String?
 challengeUntil DateTime?
 failedAttempts Int @default(0)
 blockedUntil DateTime?
}

model AuditoriaAdmin {
 id String @id @default(uuid())
 actorId String
 accion String
 ruta String
 status Int
 createdAt DateTime @default(now())
 @@index([createdAt,id])
}

model DireccionGuardada {
  id String @id @default(uuid())
  userId String
  usuario Usuario @relation(fields:[userId],references:[id],onDelete:Restrict)
  alias String
  provincia String
  ciudad String
  direccion String
  codigoPostal String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,createdAt])
}

model Favorito {
  id String @id @default(uuid())
  userId String
  usuario Usuario @relation(fields:[userId],references:[id],onDelete:Restrict)
  productoId String
  producto Producto @relation(fields:[productoId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  @@unique([userId,productoId])
  @@index([productoId])
}

model ResenaProducto {
  id String @id @default(uuid())
  userId String
  usuario Usuario @relation(fields:[userId],references:[id],onDelete:Restrict)
  productoId String
  producto Producto @relation(fields:[productoId],references:[id],onDelete:Restrict)
  detalleId String @unique
  detallePedido PedidoDetalle @relation(fields:[detalleId],references:[id],onDelete:Restrict)
  puntuacion Int
  comentario String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId,productoId])
  @@index([productoId,createdAt])
  @@index([userId,createdAt])
}

model EntregaIncidencia {
  id String @id @default(uuid())
  entregaId String
  entrega Entrega @relation(fields:[entregaId],references:[id],onDelete:Restrict)
  actorId String
  actor Usuario @relation(fields:[actorId],references:[id],onDelete:Restrict)
  tipo String
  descripcion String
  resueltaAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([entregaId,createdAt])
  @@index([actorId])
}

model RegistroPendiente {
 usuarioId String @id
 usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 email String
 secretHash String @unique
 tokenVersion Int
 tokenEpoch String?
 createdAt DateTime @default(now())
 expiresAt DateTime
 consumedAt DateTime?
 sessionId String? @unique
 session SesionWeb? @relation(fields:[sessionId],references:[id],onDelete:SetNull,onUpdate:Cascade)
}

model RevisionCatalogo {
 id String @id
 token String
}
