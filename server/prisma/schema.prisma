generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Producto {
  id          String   @id @default(uuid())
  nombre      String
  precio      Decimal
  stock       Int      @default(0)
  categoria   String
  descripcion String
  imagen      String
  alt         String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  detalles    PedidoDetalle[]
  promociones Promocion[]
  @@index([activo, categoria])
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  telefono     String
  passwordHash String
  role         String   @default("user")
  tokenVersion Int      @default(0)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  pedidos      Pedido[]
  cambiosPedidos PedidoEstado[]
}

model Pedido {
  id             String   @id @default(uuid())
  userId         String
  usuario        Usuario  @relation(fields: [userId], references: [id], onDelete: Restrict)
  total          Decimal
  estado         String   @default("pendiente")
  entrega        String
  nombre         String
  email          String
  telefono       String
  documento      String
  provincia      String?
  ciudad         String?
  direccion      String?
  codigoPostal   String?
  requestKey     String
  fingerprint    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  detalles       PedidoDetalle[]
  historial      PedidoEstado[]
  @@unique([userId, requestKey])
  @@index([userId, createdAt])
}

model PedidoDetalle {
  id             String   @id @default(uuid())
  pedidoId       String
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  nombreProducto String
  cantidad       Int
  precioUnitario Decimal
  precioOriginal Decimal?
  descuentoPorcentaje Int @default(0)
  @@unique([pedidoId, productoId])
}

model Promocion {
  id          String   @id @default(uuid())
  titulo      String
  descripcion String
  etiqueta    String
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  activa      Boolean  @default(true)
  vistaPrevia Boolean  @default(false)
  descuentoPorcentaje Int @default(0)
  imagen      String?
  alt         String?
  orden       Int      @default(0)
  inicio      DateTime?
  fin         DateTime?
  createdAt   DateTime @default(now())
}

model PedidoEstado {
  id        String   @id @default(uuid())
  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  anterior  String?
  estado    String
  actorId   String
  actor     Usuario  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([pedidoId, createdAt])
}

// Technical marker: the initial catalog is seeded once, including legacy DBs.
model Semilla {
  id        String   @id
  createdAt DateTime @default(now())
}
