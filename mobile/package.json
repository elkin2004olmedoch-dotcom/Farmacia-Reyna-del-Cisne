{
  "name": "reina-del-cisne-reparto",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.13"},
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "test:ui": "node ../node_modules/@playwright/test/cli.js test test/ui.spec.cjs --workers=1 --reporter=line",
    "sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "@capacitor/cli": {
      "glob": "14.0.3",
      "minimatch": "11.0.3"
    }
  }
}
